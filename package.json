{
	"name": "reverentgeek",
	"version": "3.2.6",
	"description": "My personal calling card.",
	"main": "./bin/card.js",
	"bin": {
		"reverentgeek": "./bin/card.js"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
